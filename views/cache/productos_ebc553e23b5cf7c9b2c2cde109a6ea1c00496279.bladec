<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('contenido'); ?>
 <div class="container mt-4">
 <h2 class="mb-4">Productos</h2>
 <table class="table table-striped">
 <thead>
 <tr>
 <th>ID</th>
 <th>NOMBRE</th>
 <th>PRECIO</th>
 <th>VALORACIÓN</th>
 <th colspan="2">VALORAR</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $productos; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $producto): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($producto->getId()??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($producto->getNombre()??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($producto->getPvp()??'', ENT_QUOTES, 'UTF-8', false); ?> €</td>
 <td>
 <div id="votos_<?php echo \htmlentities($producto->getId()??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php 
 $media = $votosDAO->recuperaMediaVotos($producto->getId());
 $total = $votosDAO->contarVotos($producto->getId());
 ?>
 <?php if($total > 0): ?>
 <?php echo \htmlentities($total??'', ENT_QUOTES, 'UTF-8', false); ?> <?php echo \htmlentities($total === 1 ? 'Valoración' : 'Valoraciones'??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php echo \App\PintarEstrellas::render($media); ?>

 <?php else: ?>
 Sin valorar
 <?php endif; ?>
 </div>
 </td>
 <td>
 <select class="form-select form-select-sm select-voto" 
 style="width:80px;display:inline"
 data-producto="<?php echo \htmlentities($producto->getId()??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php for($i = 1; $i <= 5; $i++): ?>
 <option value="<?php echo \htmlentities($i??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($i??'', ENT_QUOTES, 'UTF-8', false); ?></option>
 <?php endfor; ?>
 </select>
 </td>
 <td>
 <button class="btn btn-sm btn-primary btn-votar"
 data-producto="<?php echo \htmlentities($producto->getId()??'', ENT_QUOTES, 'UTF-8', false); ?>">Votar</button>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 </div>
<?php $this->stopSection(); ?>

<?php $this->startSection('scripts'); ?>
 <script src="js/votos.js"></script>
